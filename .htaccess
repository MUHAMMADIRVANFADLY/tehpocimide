<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Route /access_admin directly to access_admin.html
    RewriteRule ^access_admin/?$ access_admin.html [L,QSA]

    # Standard routing
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . index.html [L]
</IfModule>
